{
  "name": "armgddn-downloader",
  "version": "4.3.35",
  "description": "ARMGDDN Companion - Fast rclone-powered download manager",
  "main": "main.js",
  "author": {
    "name": "Armgddn Games",
    "email": "armgddn@armgddn.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "postversion": "node sync-version.js"
  },
  "build": {
    "appId": "com.armgddn.downloader",
    "productName": "ARMGDDN Companion",
    "asarUnpack": [
      "assets/**/*.mp4",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-update.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "rclone/win32",
          "to": "rclone",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "node_modules/7zip-bin/win",
          "to": "7z/win",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "warningsAsErrors": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "ARMGDDN.Companion-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "rclone/linux",
          "to": "rclone",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "node_modules/7zip-bin/linux",
          "to": "7z/linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "pkg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "rclone/darwin",
          "to": "rclone",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "node_modules/7zip-bin/mac",
          "to": "7z/mac",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "protocols": {
      "name": "ARMGDDN Protocol",
      "schemes": [
        "armgddn"
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "ajv": "^6.12.6",
    "glob": "^13.0.0",
    "rimraf": "^5.0.0",
    "@electron/get": "^5.0.0",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.6",
    "tar": "^7.5.15",
    "ip-address": "^10.2.0",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.4",
    "@xmldom/xmldom": "~0.8.13"
  }
}
